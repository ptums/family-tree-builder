# Copy to .env.local and fill in. Never commit real values.
# Production and preview values live in Vercel project settings (vercel pull fetches them in CI).

# Neon Postgres. Use a Neon branch for development, not production.
DATABASE_URL=
# Server-side only; used by /api/llm (Ancestry import).
OPENAI_API_KEY=
# UploadThing (document uploads).
UPLOADTHING_TOKEN=

# Tests need none of these: Jest and Playwright use an in-memory Postgres (DATABASE_URL=pglite://memory).
