    "@tanstack/react-query": "^5.81.5",
    "@uploadthing/react": "^7.3.2",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.1",
    "idb-keyval": "^6.2.2",
    "next": "15.3.5",
    "openai": "^5.10.1",
    "pinch-zoom-pan": "^4.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
